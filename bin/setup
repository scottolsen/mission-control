#!/usr/bin/env bash
#
# bin/setup — install everything Mission Control needs to run locally.
#
# Safe to run more than once: each step checks whether a tool is already
# present and skips it if so. On macOS this fully automates the toolchain; on
# Linux it installs what it can and prints guidance for anything distro-specific.

set -euo pipefail

# --------------------------------------------------------------------------
# Output helpers
# --------------------------------------------------------------------------

if [ -t 1 ]; then
  BLUE=$'\033[1;34m'; GREEN=$'\033[1;32m'; YELLOW=$'\033[1;33m'; RED=$'\033[1;31m'; RESET=$'\033[0m'
else
  BLUE=''; GREEN=''; YELLOW=''; RED=''; RESET=''
fi

info() { printf '%s==>%s %s\n' "$BLUE" "$RESET" "$*"; }
ok()   { printf '%s ✓%s  %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '%s !%s  %s\n' "$YELLOW" "$RESET" "$*"; }
die()  { printf '%s ✗%s  %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OS="$(uname -s)"

# --------------------------------------------------------------------------
# Prerequisites
# --------------------------------------------------------------------------

ensure_build_tools() {
  case "$OS" in
    Darwin)
      if xcode-select -p >/dev/null 2>&1; then
        ok "Xcode Command Line Tools present"
      else
        info "Installing Xcode Command Line Tools (a system dialog will open)…"
        xcode-select --install || true
        die "Finish the Command Line Tools install in the dialog, then re-run bin/setup."
      fi
      ;;
    Linux)
      warn "On Linux, Tauri needs system libraries (webkit2gtk, build-essential, libssl, ayatana-appindicator)."
      warn "See the per-distro list at https://v2.tauri.app/start/prerequisites/ and install them before building."
      ;;
    *)
      warn "Unrecognized OS '$OS' — skipping system build-tool checks."
      ;;
  esac
}

ensure_rust() {
  # mise.toml pins the Rust version. Install it there rather than trusting
  # whatever cargo happens to be on PATH — an older system Rust cannot build
  # dependencies that require edition 2024.
  info "Installing the pinned Rust toolchain via mise…"
  mise install
  ok "Rust ready ($(mise exec -- cargo --version))"
}

ensure_tauri_cli() {
  if mise exec -- cargo tauri --version >/dev/null 2>&1; then
    ok "Tauri CLI present ($(mise exec -- cargo tauri --version 2>/dev/null | head -1))"
    return
  fi
  info "Installing the Tauri CLI (compiles from source — a few minutes the first time)…"
  mise exec -- cargo install tauri-cli --version "^2" --locked
  ok "Tauri CLI installed"
}

ensure_runtime_tools() {
  # Mission Control reads tmux directly and shells out to terminal-notifier for
  # desktop alerts (the same tool the Claude Code permission hook uses).
  case "$OS" in
    Darwin)
      have brew || die "Homebrew not found. Install it from https://brew.sh, then re-run bin/setup."
      if have tmux; then ok "tmux present ($(tmux -V))"; else info "Installing tmux…"; brew install tmux; fi
      if have terminal-notifier; then ok "terminal-notifier present"; else info "Installing terminal-notifier…"; brew install terminal-notifier; fi
      ;;
    *)
      have tmux || warn "tmux not found — install it before running."
      ;;
  esac
}

ensure_mise() {
  # bin/run and bin/build go through `mise exec --` so the pinned Rust is used.
  if have mise; then
    ok "mise present ($(mise --version 2>/dev/null | head -1))"
    return
  fi
  case "$OS" in
    Darwin)
      have brew || die "Homebrew not found. Install it from https://brew.sh, then re-run bin/setup."
      info "Installing mise…"
      brew install mise
      ;;
    Linux)
      info "Installing mise…"
      curl -fsSL https://mise.run | sh
      have mise || warn "mise installed to ~/.local/bin — add it to your PATH, then re-run bin/setup."
      ;;
    *)
      warn "Install mise manually: https://mise.jdx.dev"
      ;;
  esac
}

warm_dependencies() {
  info "Pre-fetching Rust dependencies so the first run builds faster…"
  mise exec -- cargo fetch --manifest-path "$REPO_ROOT/src-tauri/Cargo.toml" >/dev/null
  ok "Dependencies fetched"
}

# --------------------------------------------------------------------------
# Run
# --------------------------------------------------------------------------

main() {
  info "Setting up Mission Control…"
  ensure_build_tools
  ensure_mise
  ensure_rust
  ensure_tauri_cli
  ensure_runtime_tools
  warm_dependencies
  printf '\n'
  ok "Setup complete. Launch the app with: ${GREEN}bin/run${RESET}"
}

main "$@"
