#!/usr/bin/env bash
#
# bin/run — launch Mission Control in development mode.
#
# Thin wrapper around `cargo tauri dev`, run through the mise-pinned Rust
# toolchain. Any extra arguments are passed through. Run bin/setup first if the
# toolchain isn't installed yet.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found — run bin/setup first." >&2
  exit 1
fi

cd "$REPO_ROOT"

if ! mise exec -- cargo tauri --version >/dev/null 2>&1; then
  echo "The Tauri CLI isn't installed — run bin/setup first." >&2
  exit 1
fi

exec mise exec -- cargo tauri dev "$@"
