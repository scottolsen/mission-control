{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MissionControl",
  "version": "0.1.0",
  "identifier": "com.scottolsen.mission-control",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mission Control",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
